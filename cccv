package com.codegym.controller;

import com.codegym.model.Calculator;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.io.IOException;

@WebServlet(name = "CalculatorServlet", urlPatterns = "/calculate")
public class CalculatorServlet extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
        request.setCharacterEncoding("UTF-8");
        
        try {
            float firstOperand = Float.parseFloat(request.getParameter("first-operand"));
            float secondOperand = Float.parseFloat(request.getParameter("second-operand"));
            char operator = request.getParameter("operator").charAt(0);

            // Gọi logic tính toán từ Model
            float result = Calculator.calculate(firstOperand, secondOperand, operator);

            // Gửi dữ liệu kết quả sang trang result.jsp
            request.setAttribute("firstOperand", firstOperand);
            request.setAttribute("secondOperand", secondOperand);
            request.setAttribute("operator", operator);
            request.setAttribute("result", result);

        } catch (NumberFormatException e) {
            request.setAttribute("error", "Dữ liệu nhập vào phải là số hợp lệ!");
        } catch (ArithmeticException | RuntimeException e) {
            request.setAttribute("error", e.getMessage());
        }

        // Forward sang trang result.jsp để hiển thị
        request.getRequestDispatcher("result.jsp").forward(request, response);
    }
}
